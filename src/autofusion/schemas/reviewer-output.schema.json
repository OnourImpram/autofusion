{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autofusion.dev/schemas/reviewer-output.schema.json",
  "title": "Autofusion reviewer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "coverage", "blind_spots", "recommendation", "findings"],
  "properties": {
    "summary": {"type": "string"},
    "coverage": {
      "type": "array",
      "items": {"type": "string"}
    },
    "blind_spots": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendation": {
      "type": "string",
      "enum": ["ship", "revise", "block", "abstain"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "claim",
          "evidence",
          "suggested_fix",
          "checkable",
          "verification_id",
          "stance_key",
          "stance"
        ],
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
          "category": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "strength"],
            "properties": {
              "summary": {"type": "string"},
              "strength": {"type": "string", "enum": ["artifact-cited", "unverified"]}
            }
          },
          "suggested_fix": {"type": "string"},
          "checkable": {"type": "boolean"},
          "verification_id": {"type": ["string", "null"]},
          "stance_key": {"type": "string"},
          "stance": {"type": "string", "enum": ["supports", "opposes", "uncertain"]}
        }
      }
    }
  }
}
