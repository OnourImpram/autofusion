  "presets": {
    "fast": {
      "panel": "default",
      "max_rounds": 1,
      "signoff": "blockers-only",
      "latency_class": "fast"
    },
    "balanced": {
      "panel": "dual-opus",
      "max_rounds": 2,
      "signoff": "conditional",
      "latency_class": "balanced"
    },
    "high": {
      "panel": "quality",
      "max_rounds": 2,
      "signoff": "required",
      "latency_class": "quality-first"
    },
    "quality": {
      "alias_for": "high",
      "panel": "quality",
      "max_rounds": 2,
      "signoff": "required",
      "latency_class": "quality-first"
    },
    "budget": {
      "panel": "default",
      "max_rounds": 1,
      "cost_policy": "prefer-existing-entitlements",
      "claim_zero_cost": false
    },
    "adaptive": {
      "router": "risk-rules-v1",
      "allowed_presets": [
        "fast",
        "balanced",
        "quality"
      ],
      "direction": "escalate-only"
    },
    "parallel": {
      "panel": "external-council",
      "max_rounds": 1,
      "signoff": "external",
      "latency_class": "quality-first"
    }
  },
  "panels": {
    "default": {
      "topology": "review",
      "drafter": "self",
      "reviewers": [
        "gpt-sol"
      ],
      "arbiter": "escalate-human"
    },
    "dual-opus": {
      "topology": "dual-review",
      "drafter": "self",
      "reviewers": [
        "gpt-sol",
        "claude-opus"
      ],
      "blind": true,
      "arbiter": "escalate-human"
    },
    "quality": {
      "topology": "adversarial-review",
      "drafter": "self",
      "reviewers": [
        "gpt-sol-ultra",
        "claude-opus"
      ],
      "blind": true,
      "arbiter": "escalate-human"
    },
    "external-council": {
      "topology": "panel-rank",
      "proposers": [
        "gpt-sol",
        "claude-opus"
      ],
      "judge": "gpt-sol-ultra",
      "blind": true,
      "pairwise_order_check": true,
      "arbiter": "escalate-human"
    }
  },
  "roles": {
    "thinker": "Decompose the problem, identify assumptions, and define success criteria.",
    "reviewer": "Find consequential defects and support each claim with artifact evidence.",
    "verifier": "Map checkable claims only to trusted verification IDs.",
    "adversary": "Construct counterexamples and expose structural failure modes.",
    "judge": "Analyze agreement, contradiction, coverage, unique insight, and blind spots without naive merging."
  },
  "packs": {
    "migration": {
      "artifact_kinds": [
        "migration",
        "diff",
        "plan"
      ],
      "minimum_preset": "high",
      "allowed_topologies": [
        "adversarial-review",
        "dual-review"
      ],
      "roles": [
        "data-integrity",
        "rollback",
        "compatibility"
      ],
      "proof_policy": "required-for-blocker-major"
    },
    "security": {
      "artifact_kinds": [
        "diff",
        "plan",
        "incident"
      ],
      "minimum_preset": "high",
      "allowed_topologies": [
        "adversarial-review",
        "dual-review"
      ],
      "roles": [
        "threat-model",
        "exploitability",
        "mitigation"
      ],
      "proof_policy": "required-for-blocker-major"
    },
    "release": {
      "artifact_kinds": [
        "release",
        "diff"
      ],
      "minimum_preset": "balanced",
      "allowed_topologies": [
        "review",
        "dual-review"
      ],
      "roles": [
        "regression",
        "observability",
        "rollback"
      ],
      "proof_policy": "preferred"
    },
    "incident": {
      "artifact_kinds": [
        "incident"
      ],
      "minimum_preset": "high",
      "allowed_topologies": [
        "adversarial-review",
        "dual-review"
      ],
      "roles": [
        "timeline",
        "competing-hypotheses",
        "containment"
      ],
      "proof_policy": "preferred"
    },
    "api-contract": {
      "artifact_kinds": [
        "api-contract",
        "diff",
        "plan"
      ],
      "minimum_preset": "balanced",
      "allowed_topologies": [
        "review",
        "dual-review"
      ],
      "roles": [
        "compatibility",
        "consumer-impact",
        "versioning"
      ],
      "proof_policy": "required-for-blocker-major"
    },
    "dependency": {
      "artifact_kinds": [
        "dependency",
        "diff"
      ],
      "minimum_preset": "balanced",
      "allowed_topologies": [
        "review",
        "adversarial-review",
        "dual-review"
      ],
      "roles": [
        "license",
        "vulnerability",
        "supply-chain"
      ],
      "proof_policy": "preferred"
    },
    "research-evidence": {
      "artifact_kinds": [
        "research-synthesis",
        "answer",
        "plan"
      ],
      "minimum_preset": "balanced",
      "allowed_topologies": [
        "review",
        "dual-review",
        "panel-rank"
      ],
      "roles": [
        "source-quality",
        "claim-traceability",
        "contradiction"
      ],
      "proof_policy": "not-applicable"
    }
  },
  "routing": {
    "require_explicit_fusion_invocation": true,
    "signals": [
      "artifact-kind",
      "reversibility",
      "verification-strength",
      "sensitive-paths",
      "cross-module-scope",
      "model-availability",
      "latency-budget",
      "cost-budget"
    ],
    "hard_gates": {
      "patterns": [
        "**/auth/**",
        "**/migrations/**",
        "**/permissions/**",
        "**/payments/**",
        "**/infrastructure/**"
      ],
      "minimum_preset": "balanced"
    },
    "compound": {
      "max_depth": 1,
      "default_allow_as_panel_member": false,
      "allowed_handles": [
        "gpt-sol-ultra",
        "astra-ultra"
      ],
      "allowed_roles": {
        "gpt-sol-ultra": [
          "reviewer",
          "judge"
        ],
        "astra-ultra": [
          "reviewer",
          "judge"
        ]
      },
      "count_hidden_workers_as_independent": false
    }
  },
  "orchestration": {
    "max_workflow_steps": 5,
    "per_step_routing": true,
    "communication_graph": "explicit-access-list",
    "intra_workflow_tool_trace_isolation": true,
    "inter_workflow_memory": "hash-addressed-approved-only",
    "function_call_owner_required": true,
    "marginal_value_stop": "shadow"
  },
  "provider_routing": {
    "allow_fallbacks": true,
    "fallback_scope": "same-model-endpoint",
    "model_fallback_requires_explicit_policy": true,
    "fallback_on": [
      "rate-limit",
      "provider-unavailable",
      "timeout"
    ],
    "never_fallback_on": [
      "policy-blocked",
      "moderation-blocked",
      "identity-unverified"
    ],
    "require_parameters": true,
    "effective_identity_recheck": true,
    "quorum_recheck_after_fallback": true,
    "data_collection": "deny",
    "zdr": "policy-required",
    "region": "policy-required",
    "performance_thresholds": {
      "latency_percentile": "p90",
      "throughput_percentile": "p90"
    },
    "session_stickiness": {
      "within_run": true,
      "across_runs": false
    }
  },
  "output_repair": {
    "max_attempts": 1,
    "syntax_only": true,
    "record_original_hash": true,
    "record_repaired_hash": true,
    "fail_on_semantic_delta": true,
    "protected_fields": [
      "agreement_strength",
      "decision_impact",
      "finding_status",
      "severity",
      "source_ids",
      "verification_id"
    ]
  },
  "analysis": {
    "schema": "schemas/fusion-analysis.schema.json",
    "blind_model_identity": true,
    "pairwise_order_check": true,
    "agreement_is_confidence": false,
    "required_sections": [
      "consensus",
      "contradictions",
      "partial_coverage",
      "unique_insights",
      "blind_spots",
      "grounding_candidates",
      "grounding_results",
      "proof_results",
      "decision_impact"
    ]
  },
  "verification": {
    "profiles": {
      "python": {
        "commands": {
          "ruff": {
            "argv": [
              "ruff",
              "check",
              "."
            ],
            "timeout_s": 120,
            "kind": "static"
          },
          "mypy": {
            "argv": [
              "mypy",
              "--strict",
              "src",
              "tests"
            ],
            "timeout_s": 180,
            "kind": "static"
          },
          "pytest": {
            "argv": [
              "pytest",
              "-q"
            ],
            "timeout_s": 600,
            "kind": "dynamic"
          }
        }
      }
    },
    "reviewer_commands_are_advisory": true,
    "shell_strings_allowed": false,
    "network": "deny"
  },
  "proof": {
    "enabled": true,
    "docker_image": null,
    "approved_overlay_patterns": [
      "tests/autofusion_proof/**",
      "test/autofusion_proof/**",
      "spec/autofusion_proof/**"
    ],
    "max_overlay_files": 16,
    "max_overlay_bytes": 262144,
    "max_output_chars": 32000,
    "require_mutation": true,
    "require_independent_test_author": true,
    "candidate_fix_visible": false,
    "require_signed_capsules": true,
    "attestation_key_env": "AUTOFUSION_PROOF_ATTESTATION_KEY",
    "attestation_key_id": "local-proof-v1",
    "network": "deny",
    "isolation": "disposable-docker",
    "memory_mb": 1024,
    "cpus": 1.0,
    "pids_limit": 128
  },
  "precedent": {
    "enabled": true,
    "directory": ".fusion/precedents/evidence.jsonl",
    "privacy": "metadata-only",
    "retrieval_phase": "post-blind-review",
    "default_ttl_days": 180,
    "automatic_authority": false,
    "automatic_first_pass_injection": false
  },
  "guardrails": {
    "model_allowlist": [
      "gpt-sol",
      "gpt-sol-ultra",
      "claude-opus",
      "astra-ultra"
    ],
    "provider_denylist": [],
    "max_panel_size": 4,
    "max_calls_per_run": 12,
    "max_wallclock_s": 900,
    "max_output_chars_per_call": 120000,
    "prompt_injection_action": "flag",
    "sensitive_data_action": "redact",
    "reviewer_network": "provider-only",
    "verifier_network": "deny",
    "fail_closed": true
  },
  "receipts": {
    "directory": ".fusion/runs",
    "schema": "schemas/fusion-receipt.schema.json",
    "privacy": "metadata-only",
    "include_raw_prompts": false,
    "include_per_call_cost": true,
    "include_requested_and_effective_models": true,
    "include_context_hash": true
  },
  "quota_groups": {
    "openai-chatgpt": {
      "models": [
        "gpt-5.6-sol",
        "gpt-6-astra",
        "gpt-5.6-terra"
      ],
      "source": "operator-measured-2026-09-08",
      "shared_exhaustion": true
    }
  }
}
