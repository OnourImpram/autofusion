{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OnourImpram/autofusion/main/schemas/fusion-analysis.schema.json",
  "title": "autofusion panel analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "packet_hash",
    "panel",
    "topology",
    "context_complete",
    "participants",
    "consensus",
    "contradictions",
    "partial_coverage",
    "unique_insights",
    "blind_spots",
    "grounding_candidates",
    "grounding_results",
    "decision_impact",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "packet_hash": {
      "$ref": "#/$defs/hash"
    },
    "topology": {
      "enum": [
        "review",
        "adversarial-review",
        "dual-review",
        "panel-rank",
        "advisor"
      ]
    },
    "context_complete": {
      "type": "boolean"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "consensus": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consensusItem"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "partial_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "unique_insights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uniqueInsight"
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blindSpot"
      }
    },
    "grounding_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groundingCandidate"
      }
    },
    "grounding_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groundingResult"
      }
    },
    "decision_impact": {
      "$ref": "#/$defs/decisionImpact"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "panel": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "effective_model",
        "family",
        "compound",
        "worker_visibility",
        "status",
        "call_id",
        "output_hash",
        "identity_hash"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_model": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "compound": {
          "type": "boolean"
        },
        "worker_visibility": {
          "enum": [
            "transparent",
            "opaque",
            "not-applicable"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "refused",
            "failed",
            "timed-out",
            "policy-blocked"
          ]
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "output_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "strength",
        "sources"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "grounded",
            "artifact-cited",
            "corroborated",
            "unverified",
            "contradicted"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "consensusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "supporters",
        "evidence",
        "agreement_strength"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[0-9]{2,}$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "supporters": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "agreement_strength": {
          "enum": [
            "same-family",
            "cross-family"
          ]
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "positions",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^x[0-9]{2,}$"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "claim",
              "evidence"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "status": {
          "enum": [
            "resolved-by-evidence",
            "accepted-disagreement",
            "deadlock",
            "human-required"
          ]
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "covered_by",
        "missing"
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "covered_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "string"
        }
      }
    },
    "uniqueInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "insight",
        "evidence"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "insight": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "blindSpot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "reason",
        "next_action"
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groundingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "verification_id",
        "relevance"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "verification_id": {
          "type": "string",
          "minLength": 1
        },
        "relevance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groundingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "verification_id",
        "verdict",
        "exit_code",
        "output_hash",
        "execution_status",
        "failure_class",
        "matched_expected_failure",
        "invocation_hash",
        "runner_attestation_hash",
        "runner_trust"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "verification_id": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "confirmed",
            "not-reproduced",
            "inconclusive"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_status": {
          "enum": [
            "completed",
            "environment-error",
            "timeout",
            "policy-blocked",
            "runner-error"
          ]
        },
        "failure_class": {
          "enum": [
            "assertion",
            "static-diagnostic",
            "environment",
            "timeout",
            "policy",
            "runner",
            null
          ]
        },
        "matched_expected_failure": {
          "type": "boolean"
        },
        "invocation_hash": {
          "$ref": "#/$defs/hash"
        },
        "runner_attestation_hash": {
          "$ref": "#/$defs/hash"
        },
        "runner_trust": {
          "enum": [
            "trusted-runner",
            "external-runner",
            "unknown"
          ]
        }
      }
    },
    "decisionImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "effect",
        "rationale"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "effect": {
          "enum": [
            "none",
            "clarified",
            "revised",
            "blocked",
            "human-required"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_ids",
        "severity",
        "claim",
        "evidence",
        "suggested_fix",
        "checkable",
        "verification_id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f[0-9]{2,}$"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        },
        "category": {
          "type": "string"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "suggested_fix": {
          "type": "string"
        },
        "checkable": {
          "type": "boolean"
        },
        "verification_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "grounded",
            "accepted",
            "rejected",
            "deadlock",
            "resolved",
            "waived"
          ]
        }
      }
    }
  }
}
