{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OnourImpram/autofusion/main/schemas/fusion-receipt.schema.json",
  "title": "autofusion run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "state",
    "verdict",
    "topology",
    "preset",
    "fused",
    "consulted",
    "cross_model",
    "compound",
    "self_model",
    "task_hash",
    "snapshot_hash",
    "packet_hash",
    "context_complete",
    "requested_participants",
    "calls",
    "analysis_hash",
    "budgets",
    "findings",
    "degradation_reasons",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "state": {
      "enum": [
        "prepared",
        "routed",
        "frozen",
        "dispatched",
        "analyzed",
        "grounded",
        "reconciled",
        "signed_off",
        "escalated",
        "degraded",
        "failed",
        "cancelled"
      ]
    },
    "verdict": {
      "enum": [
        "ship",
        "revise",
        "blocked",
        "degraded",
        "failed",
        "cancelled",
        "not-run"
      ]
    },
    "topology": {
      "enum": [
        "review",
        "adversarial-review",
        "dual-review",
        "panel-rank",
        "advisor"
      ]
    },
    "preset": {
      "type": "string",
      "minLength": 1
    },
    "fused": {
      "type": "boolean"
    },
    "consulted": {
      "type": "boolean"
    },
    "cross_model": {
      "type": "boolean"
    },
    "compound": {
      "type": "boolean"
    },
    "self_model": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "task_hash": {
      "$ref": "#/$defs/hash"
    },
    "snapshot_hash": {
      "$ref": "#/$defs/hash"
    },
    "packet_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_complete": {
      "type": "boolean"
    },
    "requested_participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/call"
      }
    },
    "analysis_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker",
        "major",
        "minor",
        "confirmed_by_exec",
        "deadlocks"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_by_exec": {
          "type": "integer",
          "minimum": 0
        },
        "deadlocks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "degradation_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "privacy": {
      "enum": ["metadata-only", "redacted", "local-full"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested_participants": {
            "contains": {
              "const": "self"
            }
          }
        },
        "required": ["requested_participants"]
      },
      "then": {
        "properties": {
          "self_model": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "self_model": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topology": {
            "const": "advisor"
          }
        },
        "required": ["topology"]
      },
      "then": {
        "properties": {
          "fused": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topology": {
            "const": "advisor"
          },
          "state": {
            "const": "signed_off"
          }
        },
        "required": ["topology", "state"]
      },
      "then": {
        "properties": {
          "consulted": {
            "const": true
          },
          "context_complete": {
            "const": true
          },
          "packet_hash": {
            "$ref": "#/$defs/hash"
          },
          "analysis_hash": {
            "$ref": "#/$defs/hash"
          },
          "calls": {
            "minItems": 1,
            "contains": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": ["status"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consulted": {
            "const": true
          }
        },
        "required": ["consulted"]
      },
      "then": {
        "properties": {
          "fused": {
            "const": false
          },
          "calls": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["degraded", "failed", "cancelled"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "fused": {
            "const": false
          },
          "degradation_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "degraded"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "degraded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "cancelled"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "cancelled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "escalated"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "blocked"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fused": {
            "const": true
          }
        },
        "required": ["fused"]
      },
      "then": {
        "properties": {
          "consulted": {
            "const": false
          },
          "cross_model": {
            "const": true
          },
          "context_complete": {
            "const": true
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "packet_hash": {
            "$ref": "#/$defs/hash"
          },
          "analysis_hash": {
            "$ref": "#/$defs/hash"
          },
          "state": {
            "enum": ["signed_off", "escalated"]
          },
          "verdict": {
            "enum": ["ship", "revise", "blocked"]
          },
          "requested_participants": {
            "minItems": 2
          },
          "calls": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/call"
                },
                {
                  "properties": {
                    "status": {
                      "const": "completed"
                    }
                  },
                  "required": ["status"]
                }
              ]
            }
          },
          "degradation_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": ["ship", "revise"]
          }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "fused": {
            "const": true
          },
          "context_complete": {
            "const": true
          },
          "state": {
            "const": "signed_off"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "context_complete": {
            "const": false
          }
        },
        "required": ["context_complete"]
      },
      "then": {
        "properties": {
          "fused": {
            "const": false
          },
          "verdict": {
            "enum": [
              "blocked",
              "degraded",
              "failed",
              "cancelled",
              "not-run"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "handle",
        "requested_model",
        "effective_model",
        "vendor",
        "family",
        "mode",
        "compound",
        "worker_visibility",
        "status",
        "duration_ms",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "output_hash"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "effective_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "compound": {
          "type": "boolean"
        },
        "worker_visibility": {
          "enum": ["transparent", "opaque", "not-applicable"]
        },
        "status": {
          "enum": [
            "completed",
            "refused",
            "failed",
            "timed-out",
            "policy-blocked"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "output_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "effective_model": {
                "type": "string",
                "minLength": 1
              },
              "output_hash": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "used_calls",
        "max_wallclock_s",
        "wallclock_s",
        "max_cost_usd",
        "cost_usd"
      ],
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "used_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_wallclock_s": {
          "type": "integer",
          "minimum": 1
        },
        "wallclock_s": {
          "type": "number",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    }
  }
}